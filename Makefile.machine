# -Wall -Wextra -Wimplicit-interface -fPIC -fmax-errors=1 -g -fcheck=all -fbacktrace -fbounds-check -ffpe-trap= -Wrealloc-lhs
FLAGS = -c -ffree-line-length-none -O3 -mtune=native

topdir = /home/vundar/Documenti/MUMPS_5.3.3

F90      = mpif90

MUMPS    = $(topdir)/lib
PORD     = $(topdir)/PORD/lib
MUMPS3   = $(topdir)/include
METIS	 = /usr/lib
SCALAPACK	 = /usr/lib/x86_64-linux-gnu
OPTF	 = -fopenmp
FAST     = /usr/local/lib
#WORLD    = /home/vundar/Documenti/world_builder/WorldBuilder-master
WORLD    = /home/vundar/Documenti/world_builder/GeodynamicWorldBuilder-WorldBuilder-v0.4.0-340-g22227a4/GeodynamicWorldBuilder-WorldBuilder-22227a4/build

LIBS = \
-L$(MUMPS) -ldmumps -lmumps_common \
-L$(PORD) -lpord \
-L$(METIS) -lparmetis -lmetis \
/usr/lib/x86_64-linux-gnu/blas/libblas.so.3.9.0 /usr/lib/x86_64-linux-gnu/lapack/liblapack.so.3.9.0 \
-L$(SCALAPACK) -lscalapack-openmpi -lpthread \
-L/usr/lib/x86_64-linux-gnu/libmkl_blacs_openmpi_ilp64.so \
-L$(FAST) -lfastscapelib_fortran \
-L$(WORLD)/lib/ -Wl,--whole-archive -lWorldBuilder -Wl,--no-whole-archive -lstdc++

INCLUDE = \
-I$(MUMPS3) \
-I$(WORLD)/mod/