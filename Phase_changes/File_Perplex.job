awk '{if(NR>13 && $2<200000.)print($0)}' ../Perple_X/ocean2_2.tab > 2.tmp
awk '{if(NR>13)print($0)}' ../Perple_X/ocean3_2.tab > 3.tmp
cat 1.tmp 2.tmp 3.tmp > ../Perple_X/Ocean

