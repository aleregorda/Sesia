awk '{if(NR>13 && $2<200000.)print($0)}' ../Perple_X/mantle2_1.tab > 2.tmp
awk '{if(NR>13)print($0)}' ../Perple_X/mantle3_1.tab > 3.tmp
cat celle.tmp 1.tmp 2.tmp 3.tmp > ../Perple_X/Mantle

