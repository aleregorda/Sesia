awk '{if(NR>13 && $2<100000.)print($0)}' ../Perple_X/lower_cont1_2.tab > 1.tmp
awk '{if(NR>13 && $2<200000.)print($0)}' ../Perple_X/lower_cont2_2.tab > 2.tmp
awk '{if(NR>13)print($0)}' ../Perple_X/lower_cont3_2.tab > 3.tmp
cat 1.tmp 2.tmp 3.tmp > ../Perple_X/Lower_continental

awk '{if(NR>13 && $2<100000.)print($0)}' ../Perple_X/sediment1_2.tab > 1.tmp
awk '{if(NR>13 && $2<200000.)print($0)}' ../Perple_X/sediment2_2.tab > 2.tmp
awk '{if(NR>13)print($0)}' ../Perple_X/sediment3_2.tab > 3.tmp
cat 1.tmp 2.tmp 3.tmp > ../Perple_X/Sediment

